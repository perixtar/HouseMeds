# Place worker values in .env.worker and reader values in .env.api; chmod 600 both.
# Never commit either credential file.

# .env.worker — crawler and backup process only
DATABASE_URL=postgresql://housemed_worker.PROJECT:PASSWORD@POOLER:5432/postgres
SUPABASE_PROJECT_REF=PROJECT
SUPABASE_SECRET_KEY=server-only-secret-for-private-evidence-storage
CRAWL_DELAY_MS=5000

# .env.api — read API process only
READ_DATABASE_URL=postgresql://housemed_reader.PROJECT:PASSWORD@POOLER:5432/postgres
HOUSEMED_API_TOKEN=generate-a-random-secret-at-least-32-characters
HOST=127.0.0.1
PORT=63813
