# Copy to .env for local dev. Real values live in SSM Parameter Store / your
# own sandbox accounts — never put a real secret in this file or in .env
# committed to git (.env is gitignored).

# --- Target source ---
# mock (default): no real Cognito/Supabase call — the Med service runs
#   entirely against src/adapters/mock/*, reading canned data from mock-json/.
#   (fetchPrice is hardcoded either way — see CLAUDE.md.) Nothing below this
#   section needs a real value in this mode.
# aws: the real thing. Everything below must be set to real values.
TARGET_SOURCE=mock

# --- Non-secret identifiers (safe to share, cannot authenticate on their own) ---
# Only required when TARGET_SOURCE=aws.
AWS_REGION=us-west-1

# Flat vars: used by `TARGET_SOURCE=aws npm run dev` locally — always point
# these at dev's resources, never prod's.
COGNITO_USER_POOL_ID=us-west-1_0hQo3h1YV
COGNITO_APP_CLIENT_ID=6uoa3kh58qe27uhdjp45m783bo

# _DEV/_PROD-suffixed vars: read by serverless-dev.yml / serverless-prod.yml
# at deploy time (see CLAUDE.md's "Provisioned AWS infra" section for why
# dev and prod each need their own Cognito pool/client — one shared .env can
# hold both stages' identifiers this way, with no ambiguity about which one a
# given deploy uses). COGNITO_USER_POOL_ID_PROD / COGNITO_APP_CLIENT_ID_PROD
# don't exist yet — prod's pool hasn't been provisioned.
COGNITO_USER_POOL_ID_DEV=us-west-1_0hQo3h1YV
COGNITO_APP_CLIENT_ID_DEV=6uoa3kh58qe27uhdjp45m783bo
COGNITO_USER_POOL_ID_PROD=replace-once-prod-pool-is-provisioned
COGNITO_APP_CLIENT_ID_PROD=replace-once-prod-pool-is-provisioned

# This stage's live API Gateway endpoint — informational only (the deployed
# Lambda gets its own copy via a CloudFormation intrinsic, not from this
# var); kept here so docs (README.md) can reference `.env` instead of
# hardcoding the URL. Updated by deploy-project-to-aws after each deploy.
API_BASE_URL_DEV=https://9fjny1w2mi.execute-api.us-west-1.amazonaws.com

# --- Secrets ---
# Only required when TARGET_SOURCE=aws. Used two ways: (1) local dev fallback,
# read directly by config/env.ts; (2) source of truth for SSM — `init-aws-services`
# copies this value verbatim into /medhouse/{stage}/supabase-db-url when it
# creates or refreshes that parameter. Keep a real value here before running
# that skill; a placeholder here becomes a placeholder in SSM.
# Supabase's pooler connection string (Session or Transaction mode) — never a
# project holding real household data from a local machine.
SUPABASE_DB_URL=postgresql://postgres.replace-with-your-project-ref:replace-with-your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# --- App config ---
LOG_LEVEL=info
NODE_ENV=development
