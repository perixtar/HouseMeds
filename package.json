{
  "name": "housemed-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "api": "tsx src/api.ts",
    "crawl": "tsx src/cli.ts",
    "pretest": "node scripts/prepare-test-db.mjs",
    "backup": "node scripts/backup.mjs",
    "report": "node scripts/report.mjs",
