    "pilot": "tsx src/schedule.ts",
    "benchmark": "tsx src/benchmark.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "robots-parser": "3.0.1",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
