{
  "name": "housemed-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "api": "tsx src/api.ts",
    "web": "tsx src/web.ts",
    "crawl": "tsx src/cli.ts",
    "pretest": "node scripts/prepare-test-db.mjs",
    "backup": "node scripts/backup.mjs",
    "backfill:medications": "tsx scripts/backfill-normalization.ts",
    "report": "node scripts/report.mjs",
    "services": "node scripts/mac-services.mjs",
    "pilot": "tsx src/schedule.ts",
    "benchmark": "tsx src/benchmark.ts",
    "discovery:tick": "tsx src/discovery-schedule.ts",
    "e2e:live": "tsx scripts/e2e-live.mjs",
    "e2e:controlled": "node scripts/e2e-controlled.mjs",
    "ask": "tsx src/agent-cli.ts",
    "mcp:pricing": "tsx src/agent-mcp.ts",
    "e2e:agent": "tsx scripts/e2e-agent.ts",
    "e2e:agent:live": "tsx scripts/e2e-agent-live.mjs",
    "e2e:normalization": "node scripts/prepare-test-db.mjs && tsx scripts/e2e-incoming-normalization.ts",
    "e2e:normalization:live": "tsx scripts/e2e-normalization-live.ts",
    "e2e:backfill": "node scripts/prepare-test-db.mjs && tsx --test --test-name-pattern='backfill stages' tests/database.test.ts && tsx scripts/e2e-backfill-backup.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "robots-parser": "3.0.1",
    "undici": "7.29.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
