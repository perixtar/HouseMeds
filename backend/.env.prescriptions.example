AWS_REGION=us-east-1
# Local backend only: use an AWS profile allowed to invoke the existing agent runtime.
AWS_PROFILE=your-aws-profile
HOUSEMED_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT:runtime/AGENT_ID
HOUSEMED_HOUSEHOLD_ID=authorized-household-uuid
HOUSEMED_HOUSEHOLD_NAME=HouseMeds test household
HOUSEMED_PRESCRIPTION_API_TOKEN=replace-with-a-random-token-at-least-32-characters
PRESCRIPTION_API_HOST=127.0.0.1
PRESCRIPTION_API_PORT=63815
