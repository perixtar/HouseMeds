# Place worker values in .env.worker and reader values in .env.api; chmod 600 both.
# Never commit either credential file.

# .env.worker — crawler and backup process only
DATABASE_URL=postgresql://housemed_worker.PROJECT:PASSWORD@POOLER:5432/postgres
SUPABASE_PROJECT_REF=PROJECT
SUPABASE_SECRET_KEY=server-only-secret-for-private-evidence-storage
CRAWL_DELAY_MS=5000

# .env.api — read API process only
READ_DATABASE_URL=postgresql://housemed_reader.PROJECT:PASSWORD@POOLER:5432/postgres
HOUSEMED_API_TOKEN=generate-a-random-secret-at-least-32-characters
HOST=127.0.0.1
PORT=63813

# .env.backfill — dedicated migration operator only; chmod 600
BACKFILL_DATABASE_URL=postgresql://housemed_backfill.PROJECT:PASSWORD@POOLER:5432/postgres
HOUSEMED_BACKFILL_ACTOR=replace-with-reviewer-identity

# .env.agent — local CLI runner only; chmod 600; never passed to model prompts
# Planned OpenAI key name: housemed-agent-cli-dev-20260905
OPENAI_API_KEY=replace-with-the-dedicated-openai-project-key
HOUSEMED_AGENT_KEY_NAME=housemed-agent-cli-dev-20260905
HOUSEMED_AGENT_MODEL=gpt-5.4-mini-2026-03-17
